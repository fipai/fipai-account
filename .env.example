# Django 生产环境配置示例
# 复制此文件为 .env 并填入真实值

# ⚠️ 必需：至少 50 位随机字符串
DJANGO_SECRET_KEY=your-super-secret-key-here-min-50-chars

# ⚠️ 必需：设为 False
DJANGO_DEBUG=False

# ⚠️ 必需：允许访问的主机列表（逗号分隔）
DJANGO_ALLOWED_HOSTS=account.fipai.cn,localhost,127.0.0.1


# ============ JWT 签名（生产必须使用由 secret manager 注入的 RSA PEM）============
JWT_ALGORITHM=RS256
JWT_KEY_ID=fip-account-2026-01
# 多行 PEM 可使用真实换行或转义的 \\n；严禁把实际密钥提交到仓库。
JWT_SIGNING_KEY=-----BEGIN PRIVATE KEY-----\\nREPLACE_VIA_SECRET_MANAGER\\n-----END PRIVATE KEY-----
JWT_VERIFYING_KEY=-----BEGIN PUBLIC KEY-----\\nREPLACE_VIA_DEPLOYMENT_CONFIG\\n-----END PUBLIC KEY-----
# 轮换窗口内保留旧 kid -> 旧公钥；无轮换时使用空对象。不得放入私钥。
JWT_PREVIOUS_VERIFYING_KEYS={}
# 固定契约：issuer=https://account.fipai.cn，audience=fip-api（不可覆盖）

# ============ TOTP seed 加密（生产必须由 secret manager 注入）============
# 生成示例：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# key id 用于轮换定位，不是秘密；key 本身严禁提交到仓库。
TOTP_ENCRYPTION_KEY_ID=account-totp-2026-01
TOTP_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY_FROM_SECRET_MANAGER
# 轮换期间可提供旧 key 的 JSON 对象；活动 key 不得重复出现在这里。
TOTP_PREVIOUS_ENCRYPTION_KEYS={}

# ============ PostgreSQL 数据库配置 ============
# PostgreSQL 放行 gate 必须显式设为 true；缺失时开发环境使用 SQLite。
USE_POSTGRES=true
# 生产/预发布应要求服务端证书校验；CA 文件只部署到受限运行环境。
PGSSLMODE=verify-full
PGSSLROOTCERT=/secure/path/to/rds-ca.pem
DB_NAME=fipai
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# ============ 支付宝配置 ============
# 申请地址: https://open.alipay.com/develop/sandbox
# 沙箱模式: ALIPAY_SANDBOX=true (开发环境)
# 生产模式: ALIPAY_SANDBOX=false
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_SELLER_ID=your_alipay_seller_id
ALIPAY_PRIVATE_KEY=your_rsa2_private_key
ALIPAY_PUBLIC_KEY=your_alipay_public_key
ALIPAY_SANDBOX=true

# ============ 微信支付 v3 配置 ============
# 申请地址: https://pay.weixin.qq.com/index.php/core/home
# 沙箱模式只能在 DJANGO_DEBUG=true 的开发环境显式开启
WECHAT_MCHID=your_wechat_mchid
WECHAT_SERIAL_NO=your_merchant_certificate_serial_no
WECHAT_PRIVATE_KEY=your_merchant_private_key
WECHAT_APIV3_KEY=your_32_byte_apiv3_key
WECHAT_APPID=your_wechat_appid
WECHAT_SANDBOX=false

# ============ 阿里云 SMS 配置 ============
# 申请地址: https://dysms.console.aliyun.com/
# 沙箱模式: ALIYUN_SMS_SANDBOX=true (开发环境)
ALIYUN_SMS_ACCESS_KEY_ID=your_access_key_id
ALIYUN_SMS_ACCESS_KEY_SECRET=your_access_key_secret
ALIYUN_SMS_SIGN_NAME=FIPAI
ALIYUN_SMS_TEMPLATE_CODE_register=SMS_xxxxx
ALIYUN_SMS_TEMPLATE_CODE_login=SMS_xxxxx
ALIYUN_SMS_SANDBOX=true

# ============ 邮件配置 (用于发送验证邮件) ============
# 推荐使用 Resend (https://resend.com) 或 Mailgun
EMAIL_BACKEND=anymail.backends.resend.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your_resend_api_key
EMAIL_FROM=no-reply@fipai.cn

# Wagtail
WAGTAILADMIN_BASE_URL=https://fipai.cn

# 基础 URL (支付回调用)
BASE_URL=https://account.fipai.cn
