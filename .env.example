# Django 生产环境配置示例
# 复制此文件为 .env 并填入真实值

# ⚠️ 必需：至少 50 位随机字符串
DJANGO_SECRET_KEY=your-super-secret-key-here-min-50-chars

# ⚠️ 必需：设为 False
DJANGO_DEBUG=False

# ⚠️ 必需：允许访问的主机列表（逗号分隔）
DJANGO_ALLOWED_HOSTS=account.fipai.cn,localhost,127.0.0.1

# ============ PostgreSQL 数据库配置 ============
DB_NAME=fipai
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# ============ 支付宝配置 ============
# 申请地址: https://open.alipay.com/develop/sandbox
# 沙箱模式: ALIPAY_SANDBOX=true (开发环境)
# 生产模式: ALIPAY_SANDBOX=false
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_PRIVATE_KEY=your_rsa2_private_key
ALIPAY_PUBLIC_KEY=your_alipay_public_key
ALIPAY_SANDBOX=true

# ============ 微信支付配置 ============
# 申请地址: https://pay.weixin.qq.com/index.php/core/home
# 沙箱模式: WECHAT_SANDBOX=true (开发环境)
WECHAT_MCHID=your_wechat_mchid
WECHAT_APIKEY=your_wechat_apiv2_key
WECHAT_APPID=your_wechat_appid
WECHAT_SANDBOX=true

# ============ 阿里云 SMS 配置 ============
# 申请地址: https://dysms.console.aliyun.com/
# 沙箱模式: ALIYUN_SMS_SANDBOX=true (开发环境)
ALIYUN_SMS_ACCESS_KEY_ID=your_access_key_id
ALIYUN_SMS_ACCESS_KEY_SECRET=your_access_key_secret
ALIYUN_SMS_SIGN_NAME=FIPAI
ALIYUN_SMS_TEMPLATE_CODE_register=SMS_xxxxx
ALIYUN_SMS_TEMPLATE_CODE_login=SMS_xxxxx
ALIYUN_SMS_SANDBOX=true

# ============ 邮件配置 (用于发送验证邮件) ============
# 推荐使用 Resend (https://resend.com) 或 Mailgun
EMAIL_BACKEND=anymail.backends.resend.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your_resend_api_key
EMAIL_FROM=no-reply@fipai.cn

# Wagtail
WAGTAILADMIN_BASE_URL=https://fipai.cn

# 基础 URL (支付回调用)
BASE_URL=https://account.fipai.cn
